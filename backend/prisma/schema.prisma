generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES)
  createdAt    DateTime @default(now())
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  enquiries Enquiry[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String   @unique
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique
  physicalQty Int      @default(0)
  reservedQty Int      @default(0)
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model Enquiry {
  id         Int           @id @default(autoincrement())
  customerId Int
  details    String
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  customer  Customer      @relation(fields: [customerId], references: [id])
  items     EnquiryItem[]
  quotation Quotation?
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
}

model Quotation {
  id         Int             @id @default(autoincrement())
  enquiryId  Int             @unique
  validUntil DateTime?
  discount   Decimal         @default(0) @db.Decimal(5, 2)
  gst        Decimal         @default(0) @db.Decimal(5, 2)
  grandTotal Decimal         @db.Decimal(12, 2)
  status     QuotationStatus @default(DRAFT)
  createdAt  DateTime        @default(now())

  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id])
  items      QuotationItem[]
  salesOrder SalesOrder?
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineAmount  Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([quotationId, productId])
}

model SalesOrder {
  id           Int             @id @default(autoincrement())
  quotationId  Int             @unique
  status       SalesOrderStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  confirmedAt  DateTime?
  dispatchedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  items     SalesOrderItem[]
  dispatch  Dispatch?
}

model SalesOrderItem {
  id           Int @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id           Int      @id @default(autoincrement())
  salesOrderId Int      @unique
  dispatchDate DateTime @default(now())
  courierName  String?
  trackingNo   String?
  notes        String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}